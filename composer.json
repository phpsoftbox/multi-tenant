{
    "name": "phpsoftbox/multi-tenant",
    "description": "Multi-tenant extension for PhpSoftBox",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "phpsoftbox/auth": "^1.0",
        "phpsoftbox/broadcaster": "^1.0",
        "phpsoftbox/cache": "^1.0",
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/clock": "^1.0",
        "phpsoftbox/config": "^1.0",
        "phpsoftbox/database": "^1.0",
        "phpsoftbox/inflector": "^1.0",
        "phpsoftbox/orm": "^1.0",
        "phpsoftbox/profiler": "^1.0",
        "phpsoftbox/queue": "^1.0",
        "phpsoftbox/storage": "^1.0",
        "phpsoftbox/telegram": "^1.0",
        "psr/container": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7"
    },
    "suggest": {
        "phpsoftbox/mongo": "Required only for tenant:mongo:* commands and MongoDB-based tenant features."
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/http-message": "^1.0",
        "phpsoftbox/mongo": "^1.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\MultiTenant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\MultiTenant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\MultiTenant\\Cli\\TenantCommandProvider"
            ]
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    }
}
